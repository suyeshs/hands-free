    "tables": [
      "restaurant_chains",
      "location_tenants"
    ],
    "uninstall_behavior": "archive",
    "export_format": "json",
    "migration_path": "r2://multi-location/migrations"
  },

  "features": [
    {
      "name": "Chain Management",
      "description": "Create and manage restaurant chains",
      "icon": "🏢"
    },
    {
      "name": "Location Tracking",
      "description": "Track multiple restaurant locations with full metadata",
      "icon": "📍"
