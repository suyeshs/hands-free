{
  "name": "restaurant-pos-ai",
  "private": true,
  "version": "3.1.2",
  "description": "AI-First Restaurant Point of Sale System built with Tauri, React, and Bun",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lite": "./dev-lite.sh",
    "dev:web": "vite --config vite.config.web.ts",
    "build": "vite build",
    "build:staff": "tsc && vite build --mode staff",
    "build:owner": "tsc && vite build --mode owner",
    "build:web": "tsc --project tsconfig.web.json && vite build --config vite.config.web.ts",
    "preview": "vite preview",
    "preview:web": "vite preview --config vite.config.web.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.conf.dev.json",
    "android:dev": "cargo tauri android dev",
    "android:build": "cargo tauri android build --apk=true",
    "android:build:staff": "bun run build:staff && cargo tauri android build --apk --config src-tauri/tauri.conf.staff.json",
    "android:build:owner": "bun run build:owner && cargo tauri android build --apk --config src-tauri/tauri.conf.owner.json",
    "android:build:both": "bun run android:build:staff && bun run android:build:owner",
    "deploy:cf": "bun run build:web && wrangler pages deploy dist-web",
    "migrate:coorg": "bun scripts/migrate-coorg-food-company.ts",
    "camera:server": "bun run camera-server.ts",
    "camera:mqtt": "bun run camera-mqtt-server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@handsfree/plugin-sdk": "file:./packages/plugin-sdk",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-http": "^2.5.4",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.3.1",
    "@types/chroma-js": "^3.1.2",
    "chroma-js": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.26",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.554.0",
    "mqtt": "^5.15.0",
    "node-vibrant": "^4.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.66.1",
    "react-hot-toast": "^2.6.0",
    "react-qrcode-logo": "^4.0.0",
    "react-router-dom": "^7.1.1",
    "react-speech-recognition": "^4.0.1",
    "recharts": "^3.4.1",
    "semver": "^7.7.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-speech-recognition": "^3.9.6",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.22",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.17",
    "terser": "^5.44.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "wrangler": "^3.94.0"
  }
}
