# Cloudflare Worker Environment Variables

# Cloudflare Account ID (find in dashboard URL or API tokens page)
CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# Worker URL (update after deployment)
WORKER_URL=https://handsfree-orders.suyesh.workers.dev

# Environment (production/preview/development)
ENVIRONMENT=production

# ===== SECRETS (set via wrangler secret put) =====
# DO NOT commit these to git

# Cloudflare API Token with D1 and KV permissions
# Required permissions:
# - Account > D1 > Edit
# - Account > Workers KV Storage > Edit
# - Account > Workers Scripts > Edit
# CLOUDFLARE_API_TOKEN=your-api-token-here

# Optional: Cloudflare Access Service Token for authentication
# Create at: Cloudflare Dashboard → Zero Trust → Access → Service Auth
# CF_ACCESS_CLIENT_ID=your-client-id-here
# CF_ACCESS_CLIENT_SECRET=your-client-secret-here
