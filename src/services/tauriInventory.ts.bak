// ==================== DOCUMENT & TRANSACTION COMMANDS ====================

export async function saveInventoryDocument(
  doc: SaveDocumentInput,
  tenantId: string
): Promise<InventoryDocument> {
  try {
    const document = {
      id: doc.id || '',
      tenantId,
      documentType: doc.documentType,
      supplierId: doc.supplierId || null,
      filePath: doc.filePath || null,
      ocrStatus: doc.ocrStatus,
      ocrProvider: doc.ocrProvider || null,
      extractedData: doc.extractedData ? JSON.stringify(doc.extractedData) : null,
      totalAmount: doc.totalAmount || null,
      taxAmount: doc.taxAmount || null,
      documentDate: doc.documentDate || null,
      invoiceNumber: doc.invoiceNumber || null,
      processingTimeMs: doc.processingTimeMs || null,
      confidenceScore: doc.confidenceScore || null,
      createdAt: '',
      updatedAt: '',
    };

    const row = await invoke<any>('save_inventory_document', {
      document,
      tenantId,
    });
    return mapInventoryDocument(row);
  } catch (error) {
    console.error('[tauriInventory] saveInventoryDocument failed:', error);
    throw error;
  }
}

export async function getItemTransactions(
  itemId: string,
  tenantId: string,
  limit?: number
): Promise<InventoryTransaction[]> {
  try {
    const rows = await invoke<any[]>('get_item_transactions', {
      itemId,
      tenantId,
      limit: limit || null,
    });
    return rows.map(mapInventoryTransaction);
  } catch (error) {
    console.error('[tauriInventory] getItemTransactions failed:', error);
    throw error;
  }
}

// ==================== SYNC QUEUE COMMANDS ====================

export async function markSyncPending(tableName: string, recordId: string, data: any): Promise<void> {
  try {
    await invoke('mark_inventory_sync_pending', {
      tableName,
      recordId,
      data: JSON.stringify(data),
    });
  } catch (error) {
    console.error('[tauriInventory] markSyncPending failed:', error);
    throw error;
  }
}

export async function getPendingSyncs(): Promise<SyncQueueItem[]> {
  try {
    const rows = await invoke<any[]>('get_pending_inventory_syncs');
    return rows.map((row) => ({
      id: row.id,
      tableName: row.tableName || row.table_name,
      recordId: row.recordId || row.record_id,
      data: row.data,
      createdAt: row.createdAt || row.created_at,
    }));
  } catch (error) {
    console.error('[tauriInventory] getPendingSyncs failed:', error);
    throw error;
  }
}

export async function clearInventorySyncQueue(ids: number[]): Promise<void> {
  try {
    await invoke('clear_inventory_sync_queue', {
      ids,
    });
  } catch (error) {
    console.error('[tauriInventory] clearInventorySyncQueue failed:', error);
    throw error;
  }
}
