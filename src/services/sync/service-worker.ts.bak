/**
 * Sync pending menu items
 */
async function syncPendingMenu(): Promise<void> {
  try {
    console.log('[ServiceWorker] Syncing pending menu items...');
    const pendingMenuItems = await getPendingRecords('pending-menu-items');
    const pendingCategories = await getPendingRecords('pending-categories');

    if (pendingMenuItems.length > 0) {
      const menuItems = pendingMenuItems.map(item => item.data);
      const result = await syncToCloud('/menu/sync', { menuItems });
      console.log(`[ServiceWorker] Synced ${result.synced} menu items`);

      const syncedIds = pendingMenuItems.map(item => item.id);
      await clearSyncedRecords('pending-menu-items', syncedIds);
    }

    if (pendingCategories.length > 0) {
      const categories = pendingCategories.map(item => item.data);
      const result = await syncToCloud('/categories/sync', { categories });
      console.log(`[ServiceWorker] Synced ${result.synced} categories`);

      const syncedIds = pendingCategories.map(item => item.id);
      await clearSyncedRecords('pending-categories', syncedIds);
    }
  } catch (error) {
    console.error('[ServiceWorker] Menu sync failed:', error);
    throw error;
  }
}

/**
 * Sync pending staff data
 */
async function syncPendingStaff(): Promise<void> {
  try {
    console.log('[ServiceWorker] Syncing pending staff data...');
    const pendingStaff = await getPendingRecords('pending-staff');
    const pendingLoginHistory = await getPendingRecords('pending-staff-login-history');

    if (pendingStaff.length > 0) {
      const staff = pendingStaff.map(item => item.data);
      const result = await syncToCloud('/staff/sync', { staff });
      console.log(`[ServiceWorker] Synced ${result.synced} staff users`);

      const syncedIds = pendingStaff.map(item => item.id);
      await clearSyncedRecords('pending-staff', syncedIds);
    }

    if (pendingLoginHistory.length > 0) {
      const loginHistory = pendingLoginHistory.map(item => item.data);
      const result = await syncToCloud('/staff/login-history/sync', { loginHistory });
      console.log(`[ServiceWorker] Synced ${result.synced} login records`);

      const syncedIds = pendingLoginHistory.map(item => item.id);
      await clearSyncedRecords('pending-staff-login-history', syncedIds);
    }
  } catch (error) {
    console.error('[ServiceWorker] Staff sync failed:', error);
    throw error;
  }
}

/**
 * Sync pending cash management data
 */
async function syncPendingCash(): Promise<void> {
  try {
    console.log('[ServiceWorker] Syncing pending cash data...');
    const pendingRegisters = await getPendingRecords('pending-cash-registers');
    const pendingPayouts = await getPendingRecords('pending-cash-payouts');

    if (pendingRegisters.length > 0) {
      const cashRegisters = pendingRegisters.map(item => item.data);
      const result = await syncToCloud('/cash-registers/sync', { cashRegisters });
      console.log(`[ServiceWorker] Synced ${result.synced} cash registers`);

      const syncedIds = pendingRegisters.map(item => item.id);
      await clearSyncedRecords('pending-cash-registers', syncedIds);
    }

    if (pendingPayouts.length > 0) {
      const payouts = pendingPayouts.map(item => item.data);
      const result = await syncToCloud('/cash-payouts/sync', { payouts });
      console.log(`[ServiceWorker] Synced ${result.synced} payouts`);

      const syncedIds = pendingPayouts.map(item => item.id);
      await clearSyncedRecords('pending-cash-payouts', syncedIds);
    }
  } catch (error) {
    console.error('[ServiceWorker] Cash sync failed:', error);
    throw error;
  }
}

/**
 * Sync pending inventory data
 */
async function syncPendingInventory(): Promise<void> {
  try {
    console.log('[ServiceWorker] Syncing pending inventory data...');

    // Sync all inventory-related tables
    const inventoryTables = [
      { store: 'pending-inventory-suppliers', endpoint: '/inventory/suppliers/sync', key: 'suppliers' },
      { store: 'pending-inventory-items', endpoint: '/inventory/items/sync', key: 'items' },
      { store: 'pending-inventory-documents', endpoint: '/inventory/documents/sync', key: 'documents' },
      { store: 'pending-inventory-transactions', endpoint: '/inventory/transactions/sync', key: 'transactions' },
      { store: 'pending-inventory-recipes', endpoint: '/inventory/recipes/sync', key: 'recipes' },
      { store: 'pending-inventory-recipe-ingredients', endpoint: '/inventory/recipe-ingredients/sync', key: 'recipeIngredients' },
    ];

    for (const table of inventoryTables) {
      const pendingRecords = await getPendingRecords(table.store);

      if (pendingRecords.length > 0) {
        const data = pendingRecords.map(item => item.data);
        const result = await syncToCloud(table.endpoint, { [table.key]: data });
        console.log(`[ServiceWorker] Synced ${result.synced} ${table.key}`);

        const syncedIds = pendingRecords.map(item => item.id);
        await clearSyncedRecords(table.store, syncedIds);
      }
    }
  } catch (error) {
    console.error('[ServiceWorker] Inventory sync failed:', error);
    throw error;
  }
}

/**
 * Sync all pending data
 */
async function syncAllPendingData(): Promise<void> {
  console.log('[ServiceWorker] Syncing all pending data...');

  try {
    await syncPendingOrders();
    await syncPendingTips();
    await syncPendingSales();
    await syncPendingMenu();
    await syncPendingStaff();
    await syncPendingCash();
    await syncPendingInventory();

    console.log('[ServiceWorker] All pending data synced successfully');
  } catch (error) {
    console.error('[ServiceWorker] Sync all failed:', error);
    throw error;
  }
}

/**
 * Message handler for communication with main app
 */
self.addEventListener('message', (event: ExtendableMessageEvent) => {
  if (event.data && event.data.type === 'SKIP_WAITING') {
    self.skipWaiting();
  }

  if (event.data && event.data.type === 'SYNC_NOW') {
    const tag = event.data.tag || SYNC_TAGS.ALL;
    // @ts-ignore
    self.registration.sync.register(tag);
  }
});

export {};
