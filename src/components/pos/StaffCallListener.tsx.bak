/**
 * Staff Call Listener
 *
 * Listens for staff call requests from customers via QR code ordering.
 * Shows a notification popup when customers need assistance.
 */

import { useEffect, useState } from 'react';
import { listen } from '@tauri-apps/api/event';

interface StaffCallRequest {
    table_number: string;
    requests: string[];
    custom_request?: string;
    request_message: string;
    timestamp: string;
}

interface StaffCallListenerProps {
    onStaffCall?: (request: StaffCallRequest) => void;
    showNotifications?: boolean;
}

export function StaffCallListener({ onStaffCall, showNotifications = true }: StaffCallListenerProps) {
    const [recentCalls, setRecentCalls] = useState<StaffCallRequest[]>([]);
    const [showPopup, setShowPopup] = useState(false);
    const [currentCall, setCurrentCall] = useState<StaffCallRequest | null>(null);

    useEffect(() => {
        console.log('[StaffCallListener] Starting listener for staff call requests');

        // Listen for staff call events from the web server
        const unlisten = listen<StaffCallRequest>('staff-call-request', (event) => {
            console.log('[StaffCallListener] 📞 Staff call request received:', event.payload);

            const callRequest = event.payload;
            setRecentCalls(prev => [callRequest, ...prev].slice(0, 20)); // Keep last 20 calls
            setCurrentCall(callRequest);
            setShowPopup(true);

            // Play notification sound
            if (showNotifications) {
                playNotificationSound();
            }

            // Callback to parent component
            if (onStaffCall) {
                onStaffCall(callRequest);
            }

            // Auto-hide popup after 15 seconds
            setTimeout(() => {
                setShowPopup(false);
            }, 15000);
        });

        return () => {
            unlisten.then(fn => fn());
        };
    }, [onStaffCall, showNotifications]);

    const playNotificationSound = () => {
        try {
            // Different tone for staff calls (higher pitch)
            const audioContext = new (window.AudioContext || (window as any).webkitAudioContext)();
            const oscillator = audioContext.createOscillator();
            const gainNode = audioContext.createGain();

            oscillator.connect(gainNode);
            gainNode.connect(audioContext.destination);

            oscillator.frequency.value = 1000; // Higher frequency for staff calls
            oscillator.type = 'sine';

            gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.4);

            oscillator.start(audioContext.currentTime);
            oscillator.stop(audioContext.currentTime + 0.4);

            // Play twice for attention
            setTimeout(() => {
                const osc2 = audioContext.createOscillator();
                const gain2 = audioContext.createGain();
                osc2.connect(gain2);
                gain2.connect(audioContext.destination);
                osc2.frequency.value = 1000;
                osc2.type = 'sine';
                gain2.gain.setValueAtTime(0.3, audioContext.currentTime);
                gain2.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.4);
                osc2.start(audioContext.currentTime);
                osc2.stop(audioContext.currentTime + 0.4);
            }, 200);
        } catch (error) {
            console.warn('[StaffCallListener] Failed to play notification sound:', error);
        }
    };

    const acknowledgeCall = () => {
        if (!currentCall) return;

        console.log('[StaffCallListener] ✅ Staff call acknowledged:', currentCall.table_number);
        // TODO: Could mark as acknowledged in database or send confirmation
        setShowPopup(false);
    };

    if (!showPopup || !currentCall) {
        return null;
    }

    return (
        <>
            {/* Notification Popup */}
            <div className="fixed top-4 left-4 z-50 animate-slide-in-left">
                <div className="bg-card border-2 border-pink-500 rounded-lg shadow-2xl p-4 w-96">
                    {/* Header */}
                    <div className="flex items-start justify-between mb-3">
                        <div className="flex items-center gap-2">
                            <div className="w-3 h-3 bg-pink-500 rounded-full animate-pulse" />
                            <h3 className="text-lg font-bold text-foreground">Staff Call Request</h3>
                        </div>
                        <button
                            onClick={() => setShowPopup(false)}
                            className="text-muted-foreground hover:text-foreground transition-colors"
                        >
                            ✕
                        </button>
                    </div>

                    {/* Request Details */}
                    <div className="space-y-3 mb-4">
                        <div className="flex items-center justify-between">
                            <span className="text-sm text-muted-foreground">Table:</span>
                            <span className="text-xl font-bold text-foreground">
                                {currentCall.table_number}
                            </span>
                        </div>

                        {currentCall.requests.length > 0 && (
                            <div>
                                <p className="text-xs font-semibold text-muted-foreground mb-2">Requests:</p>
                                <div className="flex flex-wrap gap-2">
                                    {currentCall.requests.map((request, index) => (
                                        <span
                                            key={index}
                                            className="px-3 py-1 bg-pink-100 text-pink-700 rounded-full text-sm font-medium"
                                        >
                                            {request}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        )}

                        {currentCall.custom_request && (
                            <div className="bg-muted rounded-lg p-3">
                                <p className="text-xs font-semibold text-muted-foreground mb-1">
                                    Additional Note:
                                </p>
                                <p className="text-sm text-foreground">
                                    {currentCall.custom_request}
                                </p>
                            </div>
                        )}

                        <div className="text-xs text-muted-foreground italic">
                            {new Date(currentCall.timestamp).toLocaleTimeString()}
                        </div>
                    </div>

                    {/* Action Button */}
                    <button
                        onClick={acknowledgeCall}
                        className="w-full px-4 py-2 bg-pink-600 hover:bg-pink-700 text-white text-sm font-medium rounded transition-colors"
                    >
                        Acknowledge & Respond
                    </button>
                </div>
            </div>

            {/* Add animation styles */}
            <style>{`
                @keyframes slide-in-left {
                    from {
                        transform: translateX(-100%);
                        opacity: 0;
                    }
                    to {
                        transform: translateX(0);
                        opacity: 1;
                    }
                }
                .animate-slide-in-left {
                    animation: slide-in-left 0.3s ease-out;
                }
            `}</style>
        </>
    );
}
