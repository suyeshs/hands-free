/**
 * QR Code Ordering Settings
 *
 * Manages cloudflared tunnel for local QR code ordering.
 * Customers scan QR codes on tables → cloudflared tunnel → local web server
 */

import { useState, useEffect } from 'react';
import { invoke } from '@tauri-apps/api/core';
import { listen } from '@tauri-apps/api/event';
import { QRCode } from 'react-qrcode-logo';
import { useFloorPlanStore } from '../stores/floorPlanStore';
import { useAuthStore } from '../stores/authStore';

interface TunnelStatus {
    isRunning: boolean;
    tunnelUrl: string | null;
    error: string | null;
}

export function QROrderingSettings() {
    const [status, setStatus] = useState<TunnelStatus>({
        isRunning: false,
        tunnelUrl: null,
        error: null,
    });
    const [isLoading, setIsLoading] = useState(false);
    const [selectedTable, setSelectedTable] = useState<string | null>(null);

    const { tables } = useFloorPlanStore();
    const { user } = useAuthStore();

    // Check initial tunnel status
    useEffect(() => {
        checkTunnelStatus();

        // Listen for tunnel URL updates
        const unlisten = listen<string>('tunnel-url-ready', (event) => {
            console.log('[QR Ordering] Tunnel URL ready:', event.payload);
            setStatus(prev => ({ ...prev, tunnelUrl: event.payload, isRunning: true }));
        });

        return () => {
            unlisten.then(fn => fn());
        };
    }, []);

    const checkTunnelStatus = async () => {
        try {
            const isRunning = await invoke<boolean>('is_tunnel_running');
            setStatus(prev => ({ ...prev, isRunning }));

            if (isRunning) {
                try {
                    const url = await invoke<string>('get_tunnel_url');
                    setStatus(prev => ({ ...prev, tunnelUrl: url }));
                } catch (error) {
                    console.log('[QR Ordering] Tunnel running but URL not ready yet');
                }
            }
        } catch (error) {
            console.error('[QR Ordering] Failed to check tunnel status:', error);
        }
    };

    const handleStartTunnel = async () => {
        setIsLoading(true);
        setStatus(prev => ({ ...prev, error: null }));

        try {
            console.log('[QR Ordering] Starting cloudflared tunnel...');
            const result = await invoke<string>('start_cloudflare_tunnel');
            console.log('[QR Ordering] Tunnel started:', result);

            setStatus(prev => ({ ...prev, isRunning: true }));

            // URL will be set via event listener when ready
            setTimeout(() => checkTunnelStatus(), 1000);
        } catch (error) {
            const errorMsg = String(error);
            console.error('[QR Ordering] Failed to start tunnel:', errorMsg);
            setStatus(prev => ({ ...prev, error: errorMsg }));
        } finally {
            setIsLoading(false);
        }
    };

    const handleStopTunnel = async () => {
        setIsLoading(true);
        setStatus(prev => ({ ...prev, error: null }));

        try {
            console.log('[QR Ordering] Stopping cloudflared tunnel...');
            await invoke('stop_cloudflare_tunnel');
            console.log('[QR Ordering] Tunnel stopped');

            setStatus({ isRunning: false, tunnelUrl: null, error: null });
        } catch (error) {
            const errorMsg = String(error);
            console.error('[QR Ordering] Failed to stop tunnel:', errorMsg);
            setStatus(prev => ({ ...prev, error: errorMsg }));
        } finally {
            setIsLoading(false);
        }
    };

    const handleRestartTunnel = async () => {
        setIsLoading(true);
        setStatus(prev => ({ ...prev, error: null, tunnelUrl: null }));

        try {
            console.log('[QR Ordering] Restarting cloudflared tunnel...');
            const result = await invoke<string>('restart_tunnel');
            console.log('[QR Ordering] Tunnel restarted:', result);

            setStatus(prev => ({ ...prev, isRunning: true }));

            // URL will be set via event listener when ready
            setTimeout(() => checkTunnelStatus(), 1000);
        } catch (error) {
            const errorMsg = String(error);
            console.error('[QR Ordering] Failed to restart tunnel:', errorMsg);
            setStatus(prev => ({ ...prev, error: errorMsg }));
        } finally {
            setIsLoading(false);
        }
    };

    const getTableOrderUrl = (tableId: string): string => {
        if (!status.tunnelUrl) {
            return `Tunnel not running`;
        }
        return `${status.tunnelUrl}/order?table=${tableId}`;
    };

    const copyToClipboard = async (text: string) => {
        try {
            await navigator.clipboard.writeText(text);
            alert('Copied to clipboard!');
        } catch (error) {
            console.error('[QR Ordering] Failed to copy:', error);
        }
    };

    return (
        <div className="p-6 space-y-6">
            {/* Header */}
            <div>
                <h1 className="text-2xl font-bold text-foreground">QR Code Ordering</h1>
                <p className="text-sm text-muted-foreground mt-1">
                    Enable customers to order directly from their phones by scanning table QR codes
                </p>
            </div>

            {/* Status Card */}
            <div className="bg-card border border-border rounded-lg p-6">
                <div className="flex items-start justify-between">
                    <div>
                        <h2 className="text-lg font-semibold text-foreground mb-2">Tunnel Status</h2>
                        <div className="flex items-center gap-2">
                            <div className={`w-3 h-3 rounded-full ${status.isRunning ? 'bg-green-500' : 'bg-gray-400'}`} />
                            <span className="text-sm text-muted-foreground">
                                {status.isRunning ? 'Running' : 'Stopped'}
                            </span>
                        </div>

                        {status.tunnelUrl && (
                            <div className="mt-4 space-y-2">
                                <p className="text-xs font-medium text-muted-foreground">Public URL:</p>
                                <div className="flex items-center gap-2">
                                    <code className="text-sm bg-muted px-3 py-2 rounded flex-1 break-all">
                                        {status.tunnelUrl}
                                    </code>
                                    <button
                                        onClick={() => copyToClipboard(status.tunnelUrl!)}
                                        className="px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs rounded transition-colors"
                                    >
                                        Copy
                                    </button>
                                </div>
                            </div>
                        )}

                        {status.error && (
                            <div className="mt-4 p-3 bg-red-50 border border-red-200 rounded text-sm text-red-700">
                                {status.error}
                            </div>
                        )}
                    </div>

                    {/* Controls */}
                    <div className="flex gap-2">
                        {!status.isRunning ? (
                            <button
                                onClick={handleStartTunnel}
                                disabled={isLoading}
                                className="px-4 py-2 bg-green-600 hover:bg-green-700 disabled:bg-gray-400 text-white text-sm rounded font-medium transition-colors"
                            >
                                {isLoading ? 'Starting...' : 'Start Tunnel'}
                            </button>
                        ) : (
                            <>
                                <button
                                    onClick={handleRestartTunnel}
                                    disabled={isLoading}
                                    className="px-4 py-2 bg-blue-600 hover:bg-blue-700 disabled:bg-gray-400 text-white text-sm rounded font-medium transition-colors"
                                >
                                    {isLoading ? 'Restarting...' : 'Restart'}
                                </button>
                                <button
                                    onClick={handleStopTunnel}
                                    disabled={isLoading}
                                    className="px-4 py-2 bg-red-600 hover:bg-red-700 disabled:bg-gray-400 text-white text-sm rounded font-medium transition-colors"
                                >
                                    {isLoading ? 'Stopping...' : 'Stop Tunnel'}
                                </button>
                            </>
                        )}
                    </div>
                </div>
            </div>

            {/* How It Works */}
            <div className="bg-card border border-border rounded-lg p-6">
                <h2 className="text-lg font-semibold text-foreground mb-3">How It Works</h2>
                <ol className="space-y-2 text-sm text-muted-foreground">
                    <li className="flex gap-2">
                        <span className="font-semibold text-foreground">1.</span>
                        <span>Start the tunnel to expose your local ordering server to the internet</span>
                    </li>
                    <li className="flex gap-2">
                        <span className="font-semibold text-foreground">2.</span>
                        <span>Print QR codes for each table (generated below)</span>
                    </li>
                    <li className="flex gap-2">
                        <span className="font-semibold text-foreground">3.</span>
                        <span>Customers scan QR codes and place orders from their phones</span>
                    </li>
                    <li className="flex gap-2">
                        <span className="font-semibold text-foreground">4.</span>
                        <span>Orders appear in your POS system in real-time</span>
                    </li>
                </ol>
            </div>

            {/* Table QR Codes */}
            {status.isRunning && status.tunnelUrl && (
                <div className="bg-card border border-border rounded-lg p-6">
                    <h2 className="text-lg font-semibold text-foreground mb-4">Table QR Codes</h2>

                    {tables.length === 0 ? (
                        <p className="text-sm text-muted-foreground">
                            No tables found. Please add tables in the Floor Plan Manager first.
                        </p>
                    ) : (
                        <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                            {tables.map(table => {
                                const orderUrl = getTableOrderUrl(table.id);
                                return (
                                    <div
                                        key={table.id}
                                        className="border border-border rounded-lg p-4 hover:shadow-lg transition-shadow cursor-pointer"
                                        onClick={() => setSelectedTable(table.id === selectedTable ? null : table.id)}
                                    >
                                        <div className="text-center mb-3">
                                            <div className="text-lg font-semibold text-foreground">
                                                Table {table.tableNumber}
                                            </div>
                                            {table.sectionId && (
                                                <div className="text-xs text-muted-foreground">
                                                    {tables.find(t => t.sectionId === table.sectionId)?.sectionId || table.sectionId}
                                                </div>
                                            )}
                                        </div>

                                        <div className="bg-white p-3 rounded-lg flex justify-center">
                                            <QRCode
                                                value={orderUrl}
                                                size={120}
                                                ecLevel="M"
                                            />
                                        </div>

                                        {selectedTable === table.id && (
                                            <div className="mt-3 space-y-2">
                                                <div className="text-xs text-muted-foreground break-all">
                                                    {orderUrl}
                                                </div>
                                                <button
                                                    onClick={(e) => {
                                                        e.stopPropagation();
                                                        copyToClipboard(orderUrl);
                                                    }}
                                                    className="w-full px-2 py-1 bg-blue-600 hover:bg-blue-700 text-white text-xs rounded transition-colors"
                                                >
                                                    Copy URL
                                                </button>
                                                <button
                                                    onClick={(e) => {
                                                        e.stopPropagation();
                                                        window.print();
                                                    }}
                                                    className="w-full px-2 py-1 bg-gray-600 hover:bg-gray-700 text-white text-xs rounded transition-colors"
                                                >
                                                    Print QR Code
                                                </button>
                                            </div>
                                        )}
                                    </div>
                                );
                            })}
                        </div>
                    )}
                </div>
            )}

            {/* Warning */}
            {!status.isRunning && (
                <div className="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                    <p className="text-sm text-yellow-800">
                        <span className="font-semibold">Note:</span> The tunnel must be running for customers to access the ordering system.
                        Start the tunnel before customers begin scanning QR codes.
                    </p>
                </div>
            )}
        </div>
    );
}
