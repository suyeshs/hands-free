/**
 * D1 Sync Test Page
 * Test synchronization between local SQLite and Cloudflare D1 database
 */

import { useState } from 'react';
import { invoke } from '@tauri-apps/api/core';
import { useTenantStore } from '../stores/tenantStore';
import { getD1ProvisioningService } from '../services/d1ProvisioningService';
import { createD1SyncService } from '../services/sync/D1SyncService';
import { getDatabaseFilePath } from '../lib/database';
import { createInitialD1Sync, InitialSyncProgress } from '../services/sync/InitialD1Sync';

interface TestResult {
  step: string;
  status: 'pending' | 'running' | 'success' | 'error';
  message: string;
  details?: any;
}

export default function D1SyncTest() {
  const { tenant } = useTenantStore();
  const [testResults, setTestResults] = useState<TestResult[]>([]);
  const [isRunning, setIsRunning] = useState(false);
  const [currentStep, setCurrentStep] = useState('');
  const [syncProgress, setSyncProgress] = useState<InitialSyncProgress | null>(null);

  const addResult = (result: TestResult) => {
    setTestResults((prev) => [...prev, result]);
  };

  const updateLastResult = (updates: Partial<TestResult>) => {
    setTestResults((prev) => {
      const updated = [...prev];
      if (updated.length > 0) {
        updated[updated.length - 1] = { ...updated[updated.length - 1], ...updates };
      }
      return updated;
    });
  };

  // Test Step 1: Check tenant configuration
  const testTenantConfig = async (): Promise<boolean> => {
    addResult({
      step: 'Tenant Configuration',
      status: 'running',
      message: 'Checking tenant configuration...',
    });

    try {
      if (!tenant) {
        updateLastResult({
          status: 'error',
          message: 'No tenant configured. Please activate the device first.',
        });
        return false;
      }

      updateLastResult({
        status: 'success',
        message: 'Tenant configuration found',
        details: {
          tenantId: tenant.tenantId,
          companyName: tenant.companyName,
          d1DatabaseId: tenant.d1DatabaseId,
        },
      });
      return true;
    } catch (error) {
      updateLastResult({
        status: 'error',
        message: `Failed to check tenant config: ${error}`,
      });
      return false;
    }
  };

  // Test Step 2: Check D1 provisioning status
  const testD1Status = async (): Promise<boolean> => {
    addResult({
      step: 'D1 Status',
      status: 'running',
      message: 'Checking D1 database status...',
    });

    try {
      const service = getD1ProvisioningService();
      const status = await service.checkStatus(tenant!.tenantId);

      updateLastResult({
        status: status.provisioned ? 'success' : 'error',
        message: status.provisioned
          ? 'D1 database is provisioned'
          : 'D1 database is NOT provisioned',
        details: status,
      });

      return status.provisioned;
    } catch (error) {
      updateLastResult({
        status: 'error',
        message: `Failed to check D1 status: ${error}`,
      });
      return false;
    }
  };

  // Test Step 3: Check local SQLite data
  const testLocalData = async (): Promise<boolean> => {
    addResult({
      step: 'Local Data Check',
      status: 'running',
      message: 'Checking local SQLite data...',
    });

    try {
      const dbPath = await getDatabaseFilePath();

      // Check various tables
      const tables = [
        'menu_items',
        'menu_categories',
        'sales_transactions',
        'staff_users',
        'restaurant_settings',
      ];

      const counts: Record<string, number> = {};

      for (const table of tables) {
        try {
          const result = await invoke<any[]>('query_sqlite', {
            dbPath,
            query: `SELECT COUNT(*) as count FROM ${table}`,
            params: [],
          });
          counts[table] = result[0]?.count || 0;
        } catch (err) {
          console.warn(`Table ${table} not found or error:`, err);
          counts[table] = 0;
        }
      }

      const totalRecords = Object.values(counts).reduce((sum, count) => sum + count, 0);

      updateLastResult({
        status: totalRecords > 0 ? 'success' : 'error',
        message:
          totalRecords > 0
            ? `Found ${totalRecords} total records in local database`
            : 'No data found in local database',
        details: counts,
      });

      return totalRecords > 0;
    } catch (error) {
      updateLastResult({
        status: 'error',
        message: `Failed to check local data: ${error}`,
      });
      return false;
    }
  };

  // Test Step 4: Create test data
  const createTestData = async (): Promise<boolean> => {
    addResult({
      step: 'Create Test Data',
      status: 'running',
      message: 'Creating test data in SQLite...',
    });

    try {
      const dbPath = await getDatabaseFilePath();

      // Create a test sales transaction
      const testSaleId = `test-sale-${Date.now()}`;
      const now = new Date().toISOString();

      // Note: Tauri execute_sqlite expects all params as strings
      // sales_transactions uses 'grand_total' not 'total_amount'
      await invoke('execute_sqlite', {
        dbPath,
        query: `INSERT INTO sales_transactions
          (id, grand_total, subtotal, payment_method, payment_status, completed_at, created_at)
          VALUES (?, ?, ?, ?, ?, ?, ?)`,
        params: [testSaleId, '25.99', '25.99', 'cash', 'completed', now, now],
      });

      updateLastResult({
        status: 'success',
        message: 'Test data created successfully',
        details: { testSaleId, amount: 25.99 },
      });

      return true;
    } catch (error) {
      updateLastResult({
        status: 'error',
        message: `Failed to create test data: ${error}`,
      });
      return false;
    }
  };

  // Test Step 5: Sync to D1 (Incremental)
  const testIncrementalSync = async (): Promise<boolean> => {
    addResult({
      step: 'Incremental Sync',
      status: 'running',
      message: 'Syncing data to D1 (incremental)...',
    });

    try {
      const dbPath = await getDatabaseFilePath();
      const syncService = createD1SyncService(tenant!.tenantId, undefined, dbPath);

      // Sync sales (which includes our test data)
      const salesResult = await syncService.syncSalesToD1();

      // Sync menu
      const menuResult = await syncService.syncMenuToD1();

      // Sync staff
      const staffResult = await syncService.syncStaffToD1();

      const totalSynced = salesResult.synced + menuResult.synced + staffResult.synced;
      const totalFailed = salesResult.failed + menuResult.failed + staffResult.failed;

      updateLastResult({
        status: totalFailed > 0 ? 'error' : 'success',
        message: `Synced ${totalSynced} records, ${totalFailed} failed`,
        details: {
          sales: salesResult,
          menu: menuResult,
          staff: staffResult,
        },
      });

      return totalFailed === 0;
    } catch (error) {
      updateLastResult({
        status: 'error',
        message: `Sync failed: ${error}`,
      });
      return false;
    }
  };

  // Test Step 6a: Verify Data in D1
  const testD1Verification = async (): Promise<boolean> => {
    addResult({
      step: 'D1 Data Verification',
      status: 'running',
      message: 'Verifying data exists in D1...',
    });

    try {
      const workerUrl =
        import.meta.env.VITE_ORDERS_ENDPOINT || 'https://handsfree-orders.suyesh.workers.dev';

      // Query D1 to get record count for key tables
      const response = await fetch(
        `${workerUrl}/api/sync/${tenant!.tenantId}/verify`,
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            tables: ['sales_transactions', 'menu_items', 'staff_users'],
          }),
        }
      );

      if (!response.ok) {
        throw new Error(`Verification endpoint returned ${response.status}`);
      }

      const verification = await response.json();

      const hasData =
        verification.sales_transactions > 0 ||
        verification.menu_items > 0 ||
        verification.staff_users > 0;

      updateLastResult({
        status: hasData ? 'success' : 'error',
        message: hasData
          ? 'Data verified in D1'
          : 'No data found in D1 (may need to sync first)',
        details: verification,
      });

      return hasData;
    } catch (error) {
      updateLastResult({
        status: 'error',
        message: `Verification failed: ${error}`,
      });
      return false;
    }
  };

  // Test Step 7: Offline/Online Scenario
  const testOfflineOnlineSync = async (): Promise<boolean> => {
    addResult({
      step: 'Offline/Online Sync',
      status: 'running',
      message: 'Testing offline scenario...',
    });

    try {
      const dbPath = await getDatabaseFilePath();

      // Step 1: Create data "while offline" (just create locally, don't sync)
      const offlineRecords = [];
      for (let i = 0; i < 3; i++) {
        const testSaleId = `offline-test-${Date.now()}-${i}`;
        const now = new Date().toISOString();

        await invoke('execute_sqlite', {
          dbPath,
          query: `INSERT INTO sales_transactions
            (id, total_amount, payment_method, completed_at, created_at)
            VALUES (?, ?, ?, ?, ?)`,
          params: [testSaleId, `${15 + i}.99`, 'cash', now, now],
        });

        offlineRecords.push(testSaleId);
      }

      updateLastResult({
        status: 'running',
        message: `Created ${offlineRecords.length} offline records, now syncing...`,
      });

      // Step 2: Simulate coming back online - sync all data
      const syncService = createD1SyncService(tenant!.tenantId, undefined, dbPath);
      const syncResult = await syncService.syncSalesToD1();

      // Step 3: Verify the offline records were synced
      const synced = syncResult.synced >= offlineRecords.length;

      updateLastResult({
        status: synced ? 'success' : 'error',
        message: synced
          ? `Offline sync recovery successful: ${syncResult.synced} records synced`
          : `Some records failed to sync: ${syncResult.failed} failures`,
        details: {
          offlineRecords,
          syncResult,
        },
      });

      return synced;
    } catch (error) {
      updateLastResult({
        status: 'error',
        message: `Offline/online test failed: ${error}`,
      });
      return false;
    }
  };

  // Test Step 6: Get sync status
  const testSyncStatus = async (): Promise<boolean> => {
    addResult({
      step: 'Sync Status',
      status: 'running',
      message: 'Checking sync status...',
    });

    try {
      const dbPath = await getDatabaseFilePath();
      const syncService = createD1SyncService(tenant!.tenantId, undefined, dbPath);

      const status = await syncService.getSyncStatus();

      updateLastResult({
        status: 'success',
        message: `Retrieved status for ${status.length} tables`,
        details: status,
      });

      return true;
    } catch (error) {
      updateLastResult({
        status: 'error',
        message: `Failed to get sync status: ${error}`,
      });
      return false;
    }
  };

  // Test Step 7: Initial/Full Sync
  const testFullSync = async (): Promise<boolean> => {
    addResult({
      step: 'Full Sync',
      status: 'running',
      message: 'Performing full sync to D1...',
    });

    try {
      const dbPath = await getDatabaseFilePath();

      const initialSync = createInitialD1Sync(
        tenant!.tenantId,
        dbPath,
        (progress: InitialSyncProgress) => {
          setSyncProgress(progress);
          console.log('[Sync Progress]', progress);
        }
      );

      const result = await initialSync.performInitialSync();

      updateLastResult({
        status: result.success ? 'success' : 'error',
        message: result.success
          ? `Full sync completed: ${result.totalSynced} records synced`
          : `Full sync failed: ${result.errors.join(', ')}`,
        details: result,
      });

      return result.success;
    } catch (error) {
      updateLastResult({
        status: 'error',
        message: `Full sync failed: ${error}`,
      });
      return false;
    }
  };

  // Run all tests
  const runAllTests = async () => {
    setIsRunning(true);
    setTestResults([]);
    setSyncProgress(null);

    try {
      setCurrentStep('Checking configuration...');
      const tenantOk = await testTenantConfig();
      if (!tenantOk) return;

      setCurrentStep('Checking D1 status...');
      const d1Ok = await testD1Status();
      if (!d1Ok) {
        addResult({
          step: 'Warning',
          status: 'error',
          message:
            'D1 not provisioned. Please provision D1 first from Settings > Cloud Sync.',
        });
        return;
      }

      setCurrentStep('Checking local data...');
      await testLocalData();

      setCurrentStep('Creating test data...');
      await createTestData();

      setCurrentStep('Testing incremental sync...');
      await testIncrementalSync();

      setCurrentStep('Verifying data in D1...');
      await testD1Verification();

      setCurrentStep('Testing offline/online scenario...');
      await testOfflineOnlineSync();

      setCurrentStep('Checking sync status...');
      await testSyncStatus();

      setCurrentStep('Tests complete');
    } catch (error) {
      console.error('Test suite failed:', error);
    } finally {
      setIsRunning(false);
      setCurrentStep('');
    }
  };

  // Run full sync test separately
  const runFullSyncTest = async () => {
    setIsRunning(true);
    setSyncProgress(null);

    try {
      const tenantOk = await testTenantConfig();
      if (!tenantOk) return;

      const d1Ok = await testD1Status();
      if (!d1Ok) return;

      await testFullSync();
    } catch (error) {
      console.error('Full sync test failed:', error);
    } finally {
      setIsRunning(false);
    }
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 p-6">
      <div className="max-w-6xl mx-auto">
        {/* Header */}
        <div className="mb-8">
          <h1 className="text-3xl font-bold text-white mb-2">D1 Sync Test Suite</h1>
          <p className="text-slate-300">
            Test synchronization between local SQLite and Cloudflare D1 database
          </p>
        </div>

        {/* Tenant Info */}
        {tenant && (
          <div className="bg-slate-800/50 backdrop-blur-sm rounded-xl p-6 mb-6 border border-slate-700">
            <h2 className="text-lg font-semibold text-white mb-3">Tenant Information</h2>
            <div className="grid grid-cols-2 gap-4 text-sm">
              <div>
                <span className="text-slate-400">Tenant ID:</span>
                <span className="ml-2 text-white font-mono">{tenant.tenantId}</span>
              </div>
              <div>
                <span className="text-slate-400">Company:</span>
                <span className="ml-2 text-white">{tenant.companyName}</span>
              </div>
              <div>
                <span className="text-slate-400">D1 Database ID:</span>
                <span className="ml-2 text-white font-mono">
                  {tenant.d1DatabaseId || 'Not set'}
                </span>
              </div>
            </div>
          </div>
        )}

        {/* Test Controls */}
        <div className="flex gap-4 mb-6">
          <button
            onClick={runAllTests}
            disabled={isRunning || !tenant}
            className="px-6 py-3 bg-blue-600 hover:bg-blue-700 disabled:bg-slate-700 disabled:text-slate-500 text-white font-semibold rounded-lg transition-colors"
          >
            {isRunning ? 'Running Tests...' : 'Run All Tests'}
          </button>

          <button
            onClick={runFullSyncTest}
            disabled={isRunning || !tenant}
            className="px-6 py-3 bg-purple-600 hover:bg-purple-700 disabled:bg-slate-700 disabled:text-slate-500 text-white font-semibold rounded-lg transition-colors"
          >
            Test Full Sync
          </button>
        </div>

        {/* Current Step */}
        {currentStep && (
          <div className="mb-6 p-4 bg-blue-500/20 border border-blue-500/50 rounded-lg">
            <p className="text-blue-300 font-medium">{currentStep}</p>
          </div>
        )}

        {/* Sync Progress */}
        {syncProgress && (
          <div className="mb-6 p-6 bg-slate-800/50 backdrop-blur-sm rounded-xl border border-slate-700">
            <h3 className="text-lg font-semibold text-white mb-4">Sync Progress</h3>
            <div className="space-y-3">
              <div>
                <div className="flex justify-between text-sm mb-2">
                  <span className="text-slate-300">{syncProgress.message}</span>
                  <span className="text-white font-semibold">{syncProgress.progress}%</span>
                </div>
                <div className="w-full bg-slate-700 rounded-full h-2">
                  <div
                    className="bg-blue-500 h-2 rounded-full transition-all duration-300"
                    style={{ width: `${syncProgress.progress}%` }}
                  />
                </div>
              </div>
              {syncProgress.currentDataType && (
                <p className="text-sm text-slate-400">
                  Current: <span className="text-white">{syncProgress.currentDataType}</span>
                </p>
              )}
            </div>
          </div>
        )}

        {/* Test Results */}
        {testResults.length > 0 && (
          <div className="bg-slate-800/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700">
            <h2 className="text-lg font-semibold text-white mb-4">Test Results</h2>
            <div className="space-y-4">
              {testResults.map((result, index) => (
                <div
                  key={index}
                  className={`p-4 rounded-lg border ${
                    result.status === 'success'
                      ? 'bg-green-500/10 border-green-500/50'
                      : result.status === 'error'
                      ? 'bg-red-500/10 border-red-500/50'
                      : result.status === 'running'
                      ? 'bg-blue-500/10 border-blue-500/50'
                      : 'bg-slate-700/50 border-slate-600'
                  }`}
                >
                  <div className="flex items-start justify-between mb-2">
                    <h3 className="font-semibold text-white">{result.step}</h3>
                    <span
                      className={`px-2 py-1 text-xs font-medium rounded ${
                        result.status === 'success'
                          ? 'bg-green-500 text-white'
                          : result.status === 'error'
                          ? 'bg-red-500 text-white'
                          : result.status === 'running'
                          ? 'bg-blue-500 text-white'
                          : 'bg-slate-600 text-slate-300'
                      }`}
                    >
                      {result.status.toUpperCase()}
                    </span>
                  </div>
                  <p className="text-slate-300 text-sm mb-2">{result.message}</p>
                  {result.details && (
                    <details className="mt-2">
                      <summary className="text-xs text-slate-400 cursor-pointer hover:text-slate-300">
                        View Details
                      </summary>
                      <pre className="mt-2 p-3 bg-slate-900/50 rounded text-xs text-slate-300 overflow-x-auto">
                        {JSON.stringify(result.details, null, 2)}
                      </pre>
                    </details>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        {/* No Results */}
        {testResults.length === 0 && !isRunning && (
          <div className="bg-slate-800/50 backdrop-blur-sm rounded-xl p-12 border border-slate-700 text-center">
            <p className="text-slate-400 text-lg">
              Click "Run All Tests" to start testing the sync
            </p>
          </div>
        )}
      </div>
    </div>
  );
}
