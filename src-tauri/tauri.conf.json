{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guanix Restaurant",
  "version": "3.1.7",
  "identifier": "com.gaunix.restaurant",
  "build": {
    "beforeDevCommand": "bun run dev -- --port 1440",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Guanix Restaurant",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": true,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://auth.handsfree.tech https://*.handsfree.tech https://*.suyesh.workers.dev https://*.pages.dev wss://*.suyesh.workers.dev; frame-src 'none'; object-src 'none'; base-uri 'self'",
      "capabilities": []
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "configs/*",
      "scripts/*",
      "cloudflared/*",
      "resources/*"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "AI-First Restaurant POS System",
    "longDescription": "HandsFree Restaurant POS - A modern point-of-sale system with kitchen display, aggregator integration, and staff management.",
    "category": "Business",
    "publisher": "StonePot Tech"
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:guanix.db",
        "sqlite:pos-dev.db",
        "sqlite:handsfree.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFNDg3MjYxQzY2NEYzMzEKUldReDgyVEdZWEpJUG5pb1RaTVlXMS9Lbnl5RXI3OTJ2ZDNJWEVPeFFuQU9jQy9RcGk2VVk1MWcK",
      "endpoints": [
        "https://github.com/suyeshs/handsfree-restaurant-pos/releases/latest/download/latest.json"
      ]
    }
  }
}
