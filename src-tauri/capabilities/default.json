{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:path:default",
    "opener:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://handsfree-restaurant-client.suyesh.workers.dev/*"
        },
        {
          "url": "https://handsfree-restaurant.suyesh.workers.dev/*"
        },
        {
          "url": "https://handsfree-tenant-router.suyesh.workers.dev/*"
        },
        {
          "url": "https://auth.handsfree.tech/*"
        },
        {
          "url": "https://*.handsfree.tech/*"
        },
        {
          "url": "https://*.suyesh.workers.dev/*"
        },
        {
          "url": "https://*.pages.dev/*"
        },
        {
          "url": "https://stonepot-restaurant-*.run.app/*"
        },
        {
          "url": "https://*.googleapis.com/*"
        },
        {
          "url": "https://*.aiplatform.googleapis.com/*"
        },
        {
          "url": "https://generativelanguage.googleapis.com/*"
        }
      ]
    },
    "http:allow-fetch",
    "http:allow-fetch-cancel",
    "http:allow-fetch-read-body",
    "http:allow-fetch-send",
    "fs:allow-temp-write",
    "fs:allow-temp-write-recursive",
    "fs:allow-temp-read"
  ]
}