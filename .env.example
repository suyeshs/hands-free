# Backend API Configuration
# HTTP API endpoint for REST calls
VITE_BACKEND_API_URL=http://localhost:3001/api

# WebSocket endpoint for real-time updates (optional - for future WebSocket integration)
# Development: ws://localhost:3001/ws
# Production: wss://your-backend-domain.com/ws
VITE_BACKEND_WS_URL=ws://localhost:3001/ws

# Backend base URL (without /api suffix)
# Used for constructing WebSocket URLs if VITE_BACKEND_WS_URL is not set
VITE_BACKEND_URL=http://localhost:3001

# Plugin Registry Configuration
# Set to 'false' to use production Cloudflare registry instead of mock data
# Set to 'true' to use mock registry even in production (for testing)
# Default: true in development, false in production
VITE_USE_MOCK_REGISTRY=true

# Plugin Registry URL (only used when USE_MOCK_REGISTRY=false)
# This should point to your deployed Cloudflare Worker
# Get this URL after running: cd workers/plugin-registry && wrangler deploy
VITE_PLUGIN_REGISTRY_URL=https://handsfree-plugin-registry.YOUR-SUBDOMAIN.workers.dev
