{
  "id": "settings-india-cafe",
  "name": "Restaurant Settings (India - Cafe)",
  "version": "1.0.0",
  "description": "Restaurant configuration for Indian cafes with flexible GST settings and optional bar management",
  "author": "Guanix",
  "icon": "☕",
  "type": "hybrid",
  "category": "core",
  "tags": ["settings", "india", "gst", "cafe", "coffee-shop"],
  "verified": true,
  "featured": true,
  "rating": 5.0,

  "frontend": {
    "wasm": "client.wasm",
    "entry_point": "init"
  },

  "backend": {
    "wasm": "worker.wasm",
    "entry_point": "handleRequest"
  },

  "data": {
    "tables": ["restaurant_settings"],
    "migration_path": "migrations/",
    "uninstall_behavior": "archive"
  },

  "region": "india",
  "restaurant_type": "cafe",

  "presets": {
    "tax": {
      "mode": "gst",
      "cgst_rate": 2.5,
      "sgst_rate": 2.5,
      "service_charge_enabled": false,
      "service_charge_rate": 5.0,
      "tax_included_in_price": false
    },
    "defaults": {
      "currency": "INR",
      "currency_symbol": "₹",
      "timezone": "Asia/Kolkata",
      "invoice_prefix": "CAFE-",
      "paper_width": 80,
      "date_format": "DD/MM/YYYY",
      "time_format": "12h"
    },
    "compliance": {
      "gst_required": true,
      "fssai_required": true,
      "pan_required": false
    },
    "features": {
      "table_management": true,
      "bar_management": false,
      "staff_pin_required": false,
      "table_filtering": false,
      "online_ordering": true,
      "takeaway_focus": true,
      "dine_in_enabled": true
    }
  },

  "layout": {
    "desktop": "single",
    "tabs": [
      {
        "id": "basics",
        "label": "Cafe Basics",
        "icon": "☕",
        "priority": "essential",
        "sections": [
          { "id": "restaurant-type", "component": "RestaurantTypeSection" },
          { "id": "restaurant-details", "component": "RestaurantDetailsSection" },
          { "id": "address-contact", "component": "AddressContactSection" },
          { "id": "online-features", "component": "OnlineFeaturesSection" },
          { "id": "logo-upload", "component": "LogoUploadSection" }
        ]
      },
      {
        "id": "tax",
        "label": "Tax & Pricing",
        "icon": "💰",
        "priority": "essential",
        "sections": [
          { "id": "tax-config", "component": "TaxConfigurationSection" },
          { "id": "legal-info", "component": "LegalInfoSection" }
        ]
      },
      {
        "id": "operations",
        "label": "Operations",
        "icon": "🖨️",
        "priority": "advanced",
        "sections": [
          { "id": "invoice-config", "component": "InvoiceConfigSection" },
          { "id": "printing", "component": "PrintingSection" }
        ]
      },
      {
        "id": "appearance",
        "label": "Appearance",
        "icon": "🎨",
        "priority": "advanced",
        "sections": [
          { "id": "appearance", "component": "AppearanceSection" }
        ]
      }
    ]
  },

  "routes": [
    {
      "path": "/settings",
      "component": "RestaurantSettings",
      "title": "Restaurant Settings",
      "protected": true,
      "roles": ["owner", "manager"]
    }
  ],

  "api_endpoints": [
    {
      "path": "/api/settings",
      "method": "GET",
      "handler": "getSettings"
    },
    {
      "path": "/api/settings",
      "method": "PUT",
      "handler": "updateSettings"
    }
  ],

  "requires_permissions": [
    "database.read.restaurant_settings",
    "database.write.restaurant_settings",
    "ui.mount.settings"
  ],

  "dependencies": [],

  "checksum": "sha256:placeholder",
  "created_at": "2026-02-09T12:00:00Z",
  "updated_at": "2026-02-09T12:00:00Z"
}
