{
  "id": "developer-tools",
  "name": "Developer Tools & Diagnostics",
  "version": "1.0.0",
  "description": "Debug utilities, telemetry collection, and diagnostic tools for development and troubleshooting",
  "author": "Guanix",
  "icon": "🔧",
  "type": "frontend",
  "category": "system",
  "tags": ["debug", "diagnostics", "telemetry", "development"],
  "verified": true,
  "featured": false,
  "rating": 5.0,
  "required": false,

  "frontend": {
    "entry_point": "init",
    "bundle": "developer-tools.js"
  },

  "routes": [
    {
      "path": "/diagnostics",
      "component": "DiagnosticsPage",
      "title": "Developer Diagnostics",
      "protected": true,
      "roles": ["owner", "manager", "developer"]
    }
  ],

  "hub_card": {
    "title": "Dev Tools",
    "description": "Debug utilities and diagnostics",
    "icon": "🔧",
    "path": "/diagnostics",
    "accent_color": "orange",
    "roles": ["owner", "manager"],
    "show_stats": false,
    "order": 99
  },

  "window_globals": [
    {
      "name": "kdsDebug",
      "description": "KDS debugging utilities",
      "methods": [
        "getOrders",
        "getStats",
        "simulateOrder",
        "clearOrders"
      ]
    },
    {
      "name": "kotDiag",
      "description": "KOT diagnostic tool",
      "methods": [
        "checkStatus",
        "testPrint",
        "viewQueue"
      ]
    },
    {
      "name": "mockOrders",
      "description": "Mock order generation for testing",
      "methods": [
        "addSwiggy",
        "addZomato",
        "addBoth",
        "clearAll"
      ]
    },
    {
      "name": "getActivationCode",
      "description": "View current activation code",
      "type": "function"
    }
  ],

  "telemetry": {
    "enabled": true,
    "collect": [
      "errors",
      "performance",
      "user_actions",
      "api_calls"
    ],
    "retention_days": 30,
    "privacy": "local_only"
  },

  "settings": [
    {
      "key": "enable_console_debug",
      "label": "Enable Console Debug Logs",
      "type": "boolean",
      "default": true,
      "description": "Show debug messages in browser console"
    },
    {
      "key": "enable_telemetry",
      "label": "Enable Telemetry Collection",
      "type": "boolean",
      "default": true,
      "description": "Collect usage and error data for debugging (stored locally)"
    },
    {
      "key": "mock_orders_enabled",
      "label": "Enable Mock Order Generation",
      "type": "boolean",
      "default": true,
      "description": "Allow creating test orders via console"
    },
    {
      "key": "performance_monitoring",
      "label": "Enable Performance Monitoring",
      "type": "boolean",
      "default": false,
      "description": "Track component render times and API latency"
    }
  ],

  "requires_permissions": [
    "ui.mount.diagnostics",
    "storage.developer_tools",
    "console.global"
  ],

  "dependencies": [],

  "checksum": "sha256:placeholder",
  "created_at": "2026-02-06T12:00:00Z",
  "updated_at": "2026-02-06T12:00:00Z"
}
