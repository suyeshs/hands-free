{
  "id": "multi-location",
  "name": "Multi-Location Management",
  "version": "2.1.0",
  "description": "Complete multi-location management for restaurant chains. Supports both centralized menu management (master-slave) and independent location menus. Real-time sales dashboard, cross-location reporting, inventory sync, staff transfers, and location-specific pricing.",
  "author": "HandsFree POS Team",
  "homepage": "https://plugins.handsfree.com/multi-location",
  "icon": "🏢",
  "type": "worker",
  "visibility": "public",
  "category": "Operations",
  "tags": ["chain", "multi-location", "franchise", "enterprise", "sync", "real-time", "centralized"],

  "verified": true,
  "featured": true,
  "rating": 4.9,
  "download_count": 3456,
  "reviews_count": 412,

  "target": {
    "client": true,
    "worker": true
  },

  "requires_app_version": ">=3.0.0",
  "requires_worker_version": ">=1.0.0",

  "requires_permissions": [
    "database.read.locations",
    "database.write.locations",
    "database.read.master_menu",
    "database.write.master_menu",
    "database.read.menu_overrides",
    "database.write.menu_overrides",
    "database.read.sales_transactions",
    "database.read.cross_location_reports",
    "storage.multi-location",
    "ui.mount.chain-management",
    "events.emit.location.*",
    "network.fetch.*.workers.dev"
  ],

  "frontend": {
    "wasm": "multi-location-client.wasm",
    "entry_point": "init",
    "routes": [
      { "path": "/chain", "component": "ChainDashboard" },
      { "path": "/chain/locations", "component": "LocationManagement" },
      { "path": "/chain/sales", "component": "RealtimeSalesDashboard" },
      { "path": "/chain/master-menu", "component": "MasterMenuEditor" },
      { "path": "/chain/reports", "component": "ConsolidatedReports" },
      { "path": "/chain/transfers", "component": "StaffTransfers" }
    ],
    "menu_items": [
      { "label": "Chain Management", "icon": "building", "path": "/chain" },
      { "label": "Locations", "icon": "map-pin", "path": "/chain/locations" },
      { "label": "Real-Time Sales", "icon": "trending-up", "path": "/chain/sales" },
      { "label": "Master Menu", "icon": "book", "path": "/chain/master-menu" }
    ]
  },

  "backend": {
    "wasm": "multi-location-worker.wasm",
    "entry_point": "init",
    "endpoints": [
      { "method": "GET", "path": "/api/chain/locations" },
      { "method": "POST", "path": "/api/chain/locations" },
      { "method": "GET", "path": "/api/chain/sales/aggregate" },
      { "method": "POST", "path": "/api/chain/menu/sync" },
      { "method": "POST", "path": "/api/chain/pricing/apply-rules" },
      { "method": "GET", "path": "/api/chain/reports/consolidated" },
      { "method": "POST", "path": "/api/chain/inventory/transfer" },
      { "method": "POST", "path": "/api/chain/staff/transfer" }
    ]
  },

  "dependencies": [],

  "compatibility": {
    "min_app_version": "3.0.0",
    "platforms": ["desktop", "web"]
  },

  "data": {
    "tables": [
      "locations",
      "master_menu",
      "location_menu_overrides",
      "location_pricing_rules",
      "cross_location_transfers"
    ],
    "uninstall_behavior": "archive",
    "export_format": "json"
  },

  "features": [
    {
      "name": "Real-Time Sales Dashboard",
      "description": "Live aggregation of sales across all locations",
      "icon": "📊"
    },
    {
      "name": "Master Menu Management",
      "description": "Centralized menu with location-specific overrides",
      "icon": "📋"
    },
    {
      "name": "Staff Transfers",
      "description": "Transfer staff between locations seamlessly",
      "icon": "👥"
    },
    {
      "name": "Inventory Sync",
      "description": "Sync inventory levels across locations",
      "icon": "📦"
    },
    {
      "name": "Location Pricing",
      "description": "Set location-specific pricing rules",
      "icon": "💰"
    }
  ],

  "analytics": {
    "enabled": true,
    "events": [
      "location_added",
      "location_removed",
      "menu_synced",
      "pricing_applied",
      "staff_transferred",
      "inventory_transferred",
      "sales_aggregated",
      "real_time_dashboard_viewed"
    ]
  },

  "lifecycle": {
    "onPermissionRevoked": "handle_permission_revoked",
    "onUpdate": "handle_update",
    "onUninstall": "handle_uninstall"
  },

  "theme_aware": true,

  "changelog": "v2.1.0: Unified multi-location and multi-location-sync plugins. Added real-time sales dashboard, improved menu management, enhanced cross-location sync.",

  "migration": {
    "from": ["multi-location-sync@1.8.0", "multi-location@2.0.0"],
    "automatic": true,
    "requires_restart": false
  },

  "checksum": "sha256:0e350142b2a27b35e04fbd37ab40e8036d15dda2a807ae84073b4f3ac697cb26",
  "created_at": "2024-09-05T00:00:00Z",
  "updated_at": "2026-02-03T00:00:00Z"
}
