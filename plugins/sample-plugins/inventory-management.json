{
  "id": "inventory-management",
  "name": "Inventory Management",
  "version": "2.5.0",
  "description": "Complete inventory tracking and management system. Track stock levels, manage suppliers, automate reordering, monitor wastage, and generate inventory reports. Includes low-stock alerts and consumption analytics.",
  "author": "HandsFree POS Team",
  "homepage": "https://plugins.handsfree.com/inventory",
  "icon": "📦",
  "type": "hybrid",
  "visibility": "public",
  "category": "Operations",
  "tags": ["inventory", "stock", "suppliers", "wastage", "reorder", "analytics"],

  "verified": true,
  "featured": true,
  "rating": 4.7,
  "download_count": 8234,
  "reviews_count": 945,

  "target": {
    "client": true,
    "worker": true
  },

  "requires_app_version": ">=3.0.0",
  "requires_worker_version": ">=1.0.0",

  "requires_permissions": [
    "database.read.inventory",
    "database.write.inventory",
    "database.read.inventory_transactions",
    "database.write.inventory_transactions",
    "database.read.suppliers",
    "database.write.suppliers",
    "database.read.purchase_orders",
    "database.write.purchase_orders",
    "storage.inventory",
    "ui.mount.inventory",
    "events.emit.inventory.*",
    "events.subscribe.order.completed"
  ],

  "frontend": {
    "wasm": "inventory-client.wasm",
    "entry_point": "init",
    "routes": [
      { "path": "/inventory", "component": "InventoryDashboard" },
      { "path": "/inventory/items", "component": "ItemsList" },
      { "path": "/inventory/transactions", "component": "TransactionLog" },
      { "path": "/inventory/suppliers", "component": "SupplierManagement" },
      { "path": "/inventory/purchase-orders", "component": "PurchaseOrders" },
      { "path": "/inventory/reports", "component": "InventoryReports" }
    ],
    "menu_items": [
      { "label": "Inventory Dashboard", "icon": "package", "path": "/inventory" },
      { "label": "Stock Items", "icon": "box", "path": "/inventory/items" },
      { "label": "Suppliers", "icon": "truck", "path": "/inventory/suppliers" },
      { "label": "Purchase Orders", "icon": "file-text", "path": "/inventory/purchase-orders" }
    ]
  },

  "backend": {
    "wasm": "inventory-worker.wasm",
    "entry_point": "init",
    "endpoints": [
      { "method": "GET", "path": "/api/inventory/items" },
      { "method": "POST", "path": "/api/inventory/items" },
      { "method": "PUT", "path": "/api/inventory/items/:id" },
      { "method": "POST", "path": "/api/inventory/transactions" },
      { "method": "GET", "path": "/api/inventory/low-stock" },
      { "method": "POST", "path": "/api/inventory/auto-reorder" },
      { "method": "GET", "path": "/api/inventory/reports/consumption" },
      { "method": "GET", "path": "/api/inventory/reports/wastage" }
    ],
    "event_handlers": [
      { "event": "order.completed", "handler": "update_stock_levels" }
    ]
  },

  "dependencies": [],

  "compatibility": {
    "min_app_version": "3.0.0",
    "platforms": ["desktop", "web"]
  },

  "data": {
    "tables": [
      "inventory_items",
      "inventory_transactions",
      "suppliers",
      "purchase_orders",
      "inventory_categories",
      "wastage_log"
    ],
    "uninstall_behavior": "archive",
    "export_format": "json"
  },

  "analytics": {
    "enabled": true,
    "events": [
      "stock_updated",
      "low_stock_alert",
      "reorder_triggered",
      "wastage_logged",
      "purchase_order_created"
    ]
  },

  "lifecycle": {
    "onPermissionRevoked": "handle_permission_revoked",
    "onUpdate": "handle_update",
    "onUninstall": "handle_uninstall"
  },

  "theme_aware": true,

  "checksum": "sha256:26968ef928ac7f1008d6805a938d0bd7703f78b443a82b128782543a8a693f4e",
  "created_at": "2024-03-15T00:00:00Z",
  "updated_at": "2026-01-29T00:00:00Z"
}
