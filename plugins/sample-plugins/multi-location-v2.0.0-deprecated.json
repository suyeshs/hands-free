{
  "id": "multi-location",
  "name": "Multi Location",
  "version": "2.0.0",
  "description": "Simplified multi-location management for restaurant chains. Same menu across all locations, separate databases with real-time sync, centralized sales dashboard for real-time aggregation across all branches.",
  "author": "HandsFree POS Team",
  "homepage": "https://plugins.handsfree.com/multi-location",
  "icon": "🏢",
  "type": "worker",
  "visibility": "public",
  "category": "Operations",
  "tags": ["chain", "multi-location", "real-time", "sales-dashboard", "sync"],

  "verified": true,
  "featured": true,
  "rating": 4.9,
  "download_count": 3456,
  "reviews_count": 412,

  "target": {
    "client": true,
    "worker": true
  },

  "requires_app_version": ">=3.0.0",
  "requires_worker_version": ">=1.0.0",

  "requires_permissions": [
    "database.read.locations",
    "database.write.locations",
    "database.read.sales_transactions",
    "storage.multi-location",
    "ui.mount.chain-management",
    "events.emit.location.*"
  ],

  "frontend": {
    "wasm": "multi-location-client.wasm",
    "entry_point": "init",
    "routes": [
      { "path": "/chain", "component": "ChainDashboard" },
      { "path": "/chain/locations", "component": "LocationManagement" },
      { "path": "/chain/sales", "component": "RealtimeSalesDashboard" },
      { "path": "/chain/reports", "component": "ConsolidatedReports" }
    ],
    "menu_items": [
      { "label": "Chain Management", "icon": "building", "path": "/chain" },
      { "label": "Locations", "icon": "map-pin", "path": "/chain/locations" },
      { "label": "Real-Time Sales", "icon": "trending-up", "path": "/chain/sales" }
    ]
  },

  "backend": {
    "wasm": "multi-location-worker.wasm",
    "entry_point": "init",
    "endpoints": [
      { "method": "GET", "path": "/api/chain/locations" },
      { "method": "POST", "path": "/api/chain/locations" },
      { "method": "GET", "path": "/api/chain/sales/aggregate" },
      { "method": "GET", "path": "/api/chain/reports/consolidated" }
    ]
  },

  "dependencies": [],

  "compatibility": {
    "min_app_version": "3.0.0",
    "platforms": ["desktop", "web"]
  },

  "data": {
    "tables": [
      "locations"
    ],
    "uninstall_behavior": "archive",
    "export_format": "json"
  },

  "analytics": {
    "enabled": true,
    "events": [
      "location_added",
      "location_removed",
      "sales_aggregated",
      "real_time_dashboard_viewed"
    ]
  },

  "lifecycle": {
    "onPermissionRevoked": "handle_permission_revoked",
    "onUpdate": "handle_update",
    "onUninstall": "handle_uninstall"
  },

  "theme_aware": true,

  "checksum": "sha256:a1b2c3d4e5f6789012345678901234567890123456789012345678901234abcd",
  "created_at": "2024-09-05T00:00:00Z",
  "updated_at": "2026-02-02T00:00:00Z"
}
