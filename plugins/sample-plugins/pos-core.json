{
  "id": "pos-core",
  "name": "POS Core",
  "version": "3.0.1",
  "description": "Essential Point of Sale functionality including order taking, payment processing, table management, and billing. The foundation of the restaurant management system.",
  "author": "HandsFree POS Team",
  "homepage": "https://plugins.handsfree.com/pos-core",
  "icon": "🛒",
  "type": "hybrid",
  "visibility": "public",
  "category": "Core",
  "tags": ["pos", "orders", "payment", "billing", "tables", "kds", "essential"],

  "verified": true,
  "featured": true,
  "rating": 4.9,
  "download_count": 12456,
  "reviews_count": 1842,
  "required": true,

  "target": {
    "client": true,
    "worker": true
  },

  "requires_app_version": ">=3.0.0",
  "requires_worker_version": ">=1.0.0",

  "requires_permissions": [
    "database.read.orders",
    "database.write.orders",
    "database.read.tables",
    "database.write.tables",
    "database.read.menu_items",
    "database.read.customers",
    "database.write.customers",
    "database.read.payments",
    "database.write.payments",
    "storage.pos-core",
    "ui.mount.pos",
    "ui.mount.kds",
    "ui.mount.billing",
    "events.emit.order.*",
    "events.subscribe.payment.*",
    "printer.access"
  ],

  "frontend": {
    "wasm": "pos-client.wasm",
    "entry_point": "init",
    "routes": [
      { "path": "/", "component": "POSDashboard" },
      { "path": "/pos", "component": "POSDashboard" },
      { "path": "/kds", "component": "KitchenDisplay" },
      { "path": "/tables", "component": "TableManagement" },
      { "path": "/billing", "component": "BillingHistory" }
    ],
    "menu_items": [
      { "label": "POS", "icon": "shopping-cart", "path": "/pos" },
      { "label": "Kitchen Display", "icon": "chef-hat", "path": "/kds" },
      { "label": "Tables", "icon": "layout-grid", "path": "/tables" },
      { "label": "Billing History", "icon": "receipt", "path": "/billing" }
    ]
  },

  "backend": {
    "wasm": "pos-worker.wasm",
    "entry_point": "init",
    "endpoints": [
      { "method": "POST", "path": "/api/orders/create" },
      { "method": "PUT", "path": "/api/orders/:id" },
      { "method": "GET", "path": "/api/orders/:id" },
      { "method": "POST", "path": "/api/orders/:id/payment" },
      { "method": "POST", "path": "/api/tables/assign" },
      { "method": "GET", "path": "/api/billing/history" }
    ]
  },

  "dependencies": [],

  "compatibility": {
    "min_app_version": "3.0.0",
    "platforms": ["desktop", "web", "mobile"]
  },

  "data": {
    "tables": [
      "orders",
      "order_items",
      "tables",
      "table_assignments",
      "payments",
      "bills",
      "kds_orders"
    ],
    "uninstall_behavior": "prevent",
    "export_format": "json"
  },

  "analytics": {
    "enabled": true,
    "events": [
      "order_created",
      "order_completed",
      "payment_processed",
      "table_assigned",
      "bill_generated"
    ]
  },

  "lifecycle": {
    "onPermissionRevoked": "handle_permission_revoked",
    "onUpdate": "handle_update",
    "onUninstall": "prevent_uninstall"
  },

  "theme_aware": true,

  "checksum": "sha256:86f0fcf2ac04750a84de56ee509e958a334195efed13906826b9eaf9536cc645",
  "created_at": "2024-01-01T00:00:00Z",
  "updated_at": "2026-01-29T12:00:00Z"
}
