{
  "name": "handsfree-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "r2_buckets": [
    {
      "binding": "TELEMETRY_LOGS",
      "bucket_name": "handsfree-telemetry-logs"
    }
  ],
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "development"
      }
    },
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging"
      }
    }
  }
}
