{
  "name": "handsfree-restaurant-provisioning",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "0f3287b287060e3215662501ee96292e",

  // Environment variables
  "vars": {
    "SERVICE_VERSION": "1.0.0",
    "BASE_DOMAIN": "handsfree.tech"
  },

  // KV Namespaces
  "kv_namespaces": [
    {
      "binding": "TENANT_METADATA",
      "id": "a9644721cac748608d3b15bf2095436b"
    },
    {
      "binding": "DOMAIN_METADATA",
      "id": "377ef00627904d78acbe3db8ef28f85e"
    }
  ],

  // Service bindings
  "services": [
    {
      "binding": "TOKEN_MANAGER",
      "service": "handsfree-token-manager"
    }
  ],

  // D1 Databases
  "d1_databases": [
    {
      "binding": "TENANTS_DB",
      "database_name": "handsfree-tenants",
      "database_id": "b2b7e8a8-c297-4176-be12-106f9471090c"
    }
  ],

  // R2 Buckets
  "r2_buckets": [
    {
      "binding": "SCHEMA_STORAGE",
      "bucket_name": "handsfree-schemas"
    }
  ],

  // Durable Objects
  "durable_objects": {
    "bindings": [
      {
        "name": "PROVISIONING_DO",
        "class_name": "ProvisioningCoordinator",
        "script_name": "handsfree-restaurant-provisioning"
      }
    ]
  },

  // Migrations for Durable Objects
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["ProvisioningCoordinator"]
    }
  ]

  // Secrets (set via wrangler secret put):
  // - CLOUDFLARE_ACCOUNT_ID
  // - CLOUDFLARE_API_TOKEN
  // - CLOUDFLARE_STORAGE_TOKEN
}
