{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handsfree-tenant-management",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "dispatch_namespaces": [
    {
      "binding": "TENANT_DISPATCH",
      "namespace": "handsfree-tenants"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TENANT_METADATA",
      "id": "a9644721cac748608d3b15bf2095436b"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
