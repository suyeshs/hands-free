{
  "name": "handsfree-restaurant-client",
  "version": "1.0.0",
  "description": "Handsfree Tech - Frontend client for restaurant ordering with multimodal display",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "npx @opennextjs/cloudflare build",
    "deploy:worker": "npm run build:worker && wrangler deploy",
    "dev:worker": "npm run build:worker && wrangler dev",
    "deploy": "npm run build:worker && wrangler deploy",
    "pages:deploy": "echo 'ERROR: Pages deployment deprecated. Use deploy:worker instead.' && exit 1",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^4.6.2",
    "@react-google-maps/api": "^2.20.7",
    "@ricky0123/vad-web": "^0.0.30",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "capnweb": "^0.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.554.0",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "next": "^14.2.0",
    "onnxruntime-web": "^1.17.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "speakeasy": "^2.0.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251128.0",
    "@opennextjs/cloudflare": "^1.12.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.17",
    "ignore-loader": "^0.1.2",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "wrangler": "^4.67.0"
  }
