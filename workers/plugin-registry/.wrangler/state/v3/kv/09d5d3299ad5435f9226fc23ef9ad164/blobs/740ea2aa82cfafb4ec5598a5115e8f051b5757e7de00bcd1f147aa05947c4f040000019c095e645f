    "menu_items": [
      { "label": "Analytics Pro", "icon": "bar-chart", "path": "/analytics" }
    ]
  },

  "backend": {
    "wasm": "analytics-worker.wasm",
    "entry_point": "init",
    "endpoints": [
      { "method": "POST", "path": "/api/analytics/generate-report" },
      { "method": "GET", "path": "/api/analytics/forecast/:metric" },
      { "method": "POST", "path": "/api/analytics/export" }
    ]
  },

  "dependencies": [],

  "compatibility": {
