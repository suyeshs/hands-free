# Tauri POS Environment Configuration
# Backend API for menu sync and operations

# HandsFree Restaurant Client Worker API
VITE_BACKEND_API_URL=https://handsfree-restaurant-client.suyesh.workers.dev/api

# Admin Panel URL (for specials, menu management)
VITE_ADMIN_PANEL_URL=https://handsfree-admin.pages.dev

# Platform API URL (for restaurant provisioning and setup)
VITE_PLATFORM_API_URL=https://handsfree-admin.pages.dev

# Restaurant Provisioning Worker (for async provisioning with Durable Objects)
VITE_PROVISIONING_URL=https://handsfree-restaurant-provisioning.suyesh.workers.dev

# Orders Worker API (for order polling fallback)
VITE_ORDERS_API_URL=https://handsfree-tenant-router.suyesh.workers.dev

# Orders Worker WebSocket URL (for real-time updates)
VITE_ORDERS_WS_URL=wss://handsfree-tenant-router.suyesh.workers.dev

# Orders Worker Endpoint (for D1 provisioning and sync - MUST BE DEPLOYED)
VITE_ORDERS_ENDPOINT=https://handsfree-tenant-router.suyesh.workers.dev

# Platform domain for tenant-specific routing (restaurant worker)
VITE_PLATFORM_DOMAIN=handsfree.tech

# Default tenant (will be overridden by device registration)
# VITE_DEFAULT_TENANT_ID=coorg-food-company-6163

# Skip auth for development (set to true to bypass tenant activation)
VITE_SKIP_AUTH=true

# Cloudflare Zero Trust Service Token (for authenticated API access)
# Create at: Cloudflare Dashboard → Zero Trust → Access → Service Auth
VITE_CF_ACCESS_CLIENT_ID=
VITE_CF_ACCESS_CLIENT_SECRET=

# Admin API Key for backend admin endpoints
# Get this from your backend configuration or Cloudflare Worker secrets
VITE_ADMIN_API_KEY=

# Sarvam AI Translation API (for multi-language support)
# Supports 22 Indian languages - ₹20 per 10k characters
# Dashboard: https://www.sarvam.ai/
SARVAM_AI_API_KEY=sk_g11w7cet_wKAOSf7c0I4ARBkyHgGs1sqU

# Google Places API (for location auto-fill from Google Maps URLs)
# Used for fetching restaurant details, ratings, reviews, and addresses
# Dashboard: https://console.cloud.google.com/google/maps-apis/
VITE_GOOGLE_PLACES_API_KEY=AIzaSyC0XJ_9JxizD-U9DZUO51u_vmjnnIO-cLY

# ============================================================================
# Handsfree Setup Agent - Gemini Live Voice Assistant
# ============================================================================

# Option 1: Vertex AI (Recommended for production)
# Requires Google Cloud project with Vertex AI API enabled
# Authentication: Application Default Credentials (ADC)
# Setup: `gcloud auth application-default login`
# Dashboard: https://console.cloud.google.com/vertex-ai

VERTEX_PROJECT_ID=handsfree-restaurant
VERTEX_LOCATION=us-central1
VERTEX_MODEL_ID=gemini-2.0-flash-live-preview-04-09

# Voice Configuration
VERTEX_AI_VOICE_NAME=Aoede
VERTEX_AI_LANGUAGE_CODE=en-IN
VERTEX_VAD_ENABLED=true
VERTEX_VAD_TIMEOUT=0.6
VERTEX_TEMPERATURE=0.3
VERTEX_MAX_TOKENS=1024

# Option 2: Gemini Direct API (Simpler for development, less secure)
# Get API key from: https://aistudio.google.com/app/apikey
# Uncomment to use Gemini API instead of Vertex AI:
# GEMINI_API_KEY=your-gemini-api-key

# ============================================================================
# Recipe AI Worker - Gemini 1.5 Flash for Recipe Generation
# ============================================================================

# Recipe AI Worker URL (deployed Cloudflare Worker)
VITE_RECIPE_AI_WORKER_URL=https://recipe-ai.suyesh.workers.dev

# Gemini API Key for Recipe Generation (REST API)
# Get from: https://aistudio.google.com/app/apikey
# This key is stored as a secret in the Cloudflare Worker
# Deploy with: cd workers/recipe-ai && wrangler secret put GEMINI_API_KEY
