{
  "name": "@handsfree/plugin-sdk",
  "version": "1.0.0-alpha.1",
  "description": "SDK for developing HandsFree POS plugins",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/types.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/types.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "handsfree",
    "pos",
    "plugin",
    "wasm",
    "sdk"
  ],
  "author": "HandsFree POS Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/handsfree/restaurant-pos-ai",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://docs.handsfree.com/plugins",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260129.0",
    "@types/node": "^20.11.5",
    "tsup": "^8.0.1",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
